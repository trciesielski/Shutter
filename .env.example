# Public, non-secret build-time settings. Never put R2 access keys or API tokens here:
# every VITE_* value is embedded in the browser bundle.

# web (default, read-only public catalog) | mobile (local file import)
VITE_PLATFORM=web

# Base URL of public music objects. Default: /music/ (same-origin Cloudflare Pages Function bound to R2 bucket "music").
# Alternative: a public R2 custom domain, e.g. https://<your-r2-public-domain>/  (requires R2 CORS, see docs/R2_PUBLIC_CATALOG.md)
VITE_MUSIC_BASE_URL=/music/

# Optional. Default: <VITE_MUSIC_BASE_URL>catalog/catalog.json
# VITE_CATALOG_URL=

# Optional, comma-separated extra origins allowed for audio/cover URLs referenced by the catalog.
# VITE_MUSIC_ALLOWED_ORIGINS=
